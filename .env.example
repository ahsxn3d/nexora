# ==========================================
# NEXORA ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Admin/Owner Email (Gets direct access to the GEMINI_API_KEY below)
ADMIN_EMAIL="your_email@gmail.com"

# 2. Server Google Gemini AI API Key (Used automatically for ADMIN_EMAIL)
GEMINI_API_KEY=""

# 3. Neon PostgreSQL Database URL for Prisma
DATABASE_URL=""

# 4. Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 5. NextAuth Configuration (1-Year Persistent Sessions)
NEXTAUTH_URL="http://localhost:3003"
NEXTAUTH_SECRET="nexora_secure_secret_key_admissions_roadmap_2026"
NEXT_PUBLIC_APP_URL="http://localhost:3003"
